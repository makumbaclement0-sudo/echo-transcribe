# ── Funding scanner ──────────────────────────────────────────────
# Optional. Override exchange API bases (e.g. for a region-appropriate host).
# FUNDING_BINANCE_BASE=https://fapi.binance.com
# FUNDING_BYBIT_BASE=https://api.bybit.com
# FUNDING_OKX_BASE=https://www.okx.com
# FUNDING_HYPERLIQUID_BASE=https://api.hyperliquid.xyz

# ── Optional login gate (HTTP Basic Auth via middleware) ─────────
# APP_USER=you
# APP_PASSWORD=choose-a-strong-password

# ── Testnet execution ────────────────────────────────────────────
# Master switch. Orders are NEVER placed unless this is exactly "true".
EXEC_ENABLED=false
# Hard risk limits (used even when armed).
EXEC_MAX_USD=100          # max notional per leg, USD
EXEC_MAX_LEVERAGE=3
EXEC_MIN_NET_APR=0.03     # reject trades whose net APR is below this (fraction)

# Execution mode: "sim" (default — fake fills at live prices, no keys) or
# "testnet" (real orders on exchange test environments; needs keys below).
EXEC_MODE=sim

# ── Auto-trader ──────────────────────────────────────────────────
# Opens the top-ranked opportunity on a schedule. Toggle live on /trade
# (the setting persists), or default it on here. Safe in sim mode.
AUTO_TRADE=false           # set true to enable the auto-trader on boot
AUTO_TRADE_INTERVAL_MIN=15 # minutes between decision cycles
AUTO_MAX_POSITIONS=3       # don't hold more than this many at once
AUTO_USD=50                # notional per leg for auto-opened pairs (capped by EXEC_MAX_USD)
AUTO_LEVERAGE=2
# AUTO_MIN_NET_APR=0.03    # open floor; defaults to EXEC_MIN_NET_APR
AUTO_CLOSE_APR=0           # close a pair when its live net APR falls below this (0 = when it goes negative)
AUTO_MAX_HOLD_HOURS=168    # also close after this many hours (0 = no time limit)
AUTO_MAX_DRAWDOWN_USD=0    # circuit-breaker: flatten all + HALT if total net P&L ≤ −this USD (0 = off)

# Binance USDⓈ-M TESTNET keys — create at https://testnet.binancefuture.com
# Use trade-only keys. Never your mainnet keys.
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Bybit TESTNET keys — create at https://testnet.bybit.com
BYBIT_TESTNET_KEY=
BYBIT_TESTNET_SECRET=

# OKX DEMO (simulated) keys — create in OKX app: Demo Trading → API.
# Trading runs against OKX demo via the x-simulated-trading header.
OKX_DEMO_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=

# Hyperliquid TESTNET — an Ethereum wallet PRIVATE KEY that signs orders.
# Use a fresh throwaway key funded only on testnet (https://app.hyperliquid-testnet.xyz).
# NEVER a wallet holding real funds. The /trade page shows which address it signs as.
HYPERLIQUID_TESTNET_PRIVKEY=

# ── Echo transcription (unrelated to the funding platform) ───────
# ANTHROPIC_API_KEY=sk-ant-...
