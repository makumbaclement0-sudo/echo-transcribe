# ===== Echo (transcription app) =====

# Required for AI summary & action items
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Whisper transcription
# WHISPER_MODEL=base            # tiny/base/small/medium/large-v3
# WHISPER_DEVICE=cpu            # cuda if you have an NVIDIA GPU
# WHISPER_COMPUTE_TYPE=int8     # float16 on GPU
# PYTHON_BIN=

# Where uploads/jobs/bot state are stored (defaults to ./data)
# DATA_DIR=

# ===== Funding-rate arbitrage bot (npm run bot) =====

# SAFETY: the bot simulates fills (paper mode) unless this is exactly "true".
# Flipping it requires an engine restart; the dashboard can never enable it.
LIVE_TRADING=false

# Run the engine INSIDE the web server process (single-service hosting).
# Leave unset/false locally and use `npm run bot` as a separate process.
# BOT_AUTOSTART=true

# Exchange API keys — only needed for LIVE trading. Paper mode and the
# scanner use public endpoints and work with no keys at all.
# Create keys with trade permission only (no withdrawals).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSWORD=            # OKX passphrase

# Strategy thresholds (annualized decimals: 0.08 = 8%/yr)
# MIN_NET_APR=0.08             # open when net APR >= this
# EXIT_APR=0.02                # close when forward funding APR < this

# Risk limits
# MAX_POSITION_USD=1000        # per-leg notional per position
# MAX_TOTAL_EXPOSURE_USD=5000  # sum across open positions
# MAX_OPEN_POSITIONS=5
# MAX_SLIPPAGE_BPS=5           # per-fill slippage allowance
# MAX_ENTRY_BASIS_PCT=0.15     # skip entries with worse adverse price basis
# PRICE_DIVERGENCE_STOP_PCT=3  # emergency close if legs diverge this far
# MAX_POSITION_AGE_HOURS=336

# Scoring / scanning
# SCAN_INTERVAL_MS=30000
# HOLD_HORIZON_HOURS=336       # horizon for amortizing entry/exit costs
# MIN_QUOTE_VOLUME_USD=2000000 # 24h volume filter per market
# SYMBOL_ALLOWLIST=            # e.g. BTC,ETH,SOL (empty = all)

# Paper mode
# PAPER_STARTING_BALANCE_USD=10000
